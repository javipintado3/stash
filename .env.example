# Firebase web app settings (Firebase console > Project settings > Your apps > Web app).
# These values are public by design: what protects the data is firestore.rules.
# Copy this file to .env.local and fill it in. Also add them in Vercel > Settings > Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
